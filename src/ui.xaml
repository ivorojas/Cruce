<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      TextElement.FontFamily="Segoe UI Variable Text, Segoe UI"
      TextOptions.TextFormattingMode="Display">
  <Grid.Resources>
    <SolidColorBrush x:Key="Text" Color="#ECEEF4"/>
    <SolidColorBrush x:Key="Muted" Color="#9097AA"/>
    <SolidColorBrush x:Key="Faint" Color="#646B7E"/>
    <SolidColorBrush x:Key="CardBg" Color="#C21A1D26"/>
    <SolidColorBrush x:Key="CardBorder" Color="#1FFFFFFF"/>
    <SolidColorBrush x:Key="FieldBg" Color="#E6141720"/>
    <SolidColorBrush x:Key="FieldBorder" Color="#2EFFFFFF"/>
    <SolidColorBrush x:Key="Accent" Color="#5B8CFF"/>
    <SolidColorBrush x:Key="Violet" Color="#9B7BFF"/>

    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource CardBg}"/>
      <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Padding" Value="18,14"/>
    </Style>
    <Style x:Key="Section" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="Label" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>
    <Style x:Key="Hint" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Faint}"/>
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Margin" Value="0,6,0,0"/>
    </Style>
    <Style x:Key="StatValue" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="FontSize" Value="24"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI"/>
    </Style>

    <Style x:Key="Seg" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="b" Background="Transparent" CornerRadius="8" Padding="14,6" Margin="1">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#14FFFFFF"/>
                <Setter Property="Foreground" Value="{StaticResource Text}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="b" Property="Background" Value="{StaticResource Accent}"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Switch" TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid Background="Transparent">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <ContentPresenter VerticalAlignment="Center" Margin="0,0,14,0"/>
              <Border x:Name="track" Grid.Column="1" Width="40" Height="22" CornerRadius="11" Background="#262B36" BorderBrush="#454C5E" BorderThickness="1">
                <Ellipse x:Name="knob" Width="12" Height="12" Fill="#AEB4C4" HorizontalAlignment="Left" Margin="5,0,0,0"/>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="track" Property="Background" Value="{StaticResource Accent}"/>
                <Setter TargetName="track" Property="BorderBrush" Value="{StaticResource Accent}"/>
                <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right"/>
                <Setter TargetName="knob" Property="Margin" Value="0,0,5,0"/>
                <Setter TargetName="knob" Property="Width" Value="14"/>
                <Setter TargetName="knob" Property="Height" Value="14"/>
                <Setter TargetName="knob" Property="Fill" Value="White"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Field" TargetType="TextBox">
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="CaretBrush" Value="White"/>
      <Setter Property="SelectionBrush" Value="{StaticResource Accent}"/>
      <Setter Property="FontSize" Value="13.5"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="bd" Background="{StaticResource FieldBg}" BorderBrush="{StaticResource FieldBorder}" BorderThickness="1" CornerRadius="8" Padding="10,7">
              <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PField" TargetType="PasswordBox">
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="CaretBrush" Value="White"/>
      <Setter Property="SelectionBrush" Value="{StaticResource Accent}"/>
      <Setter Property="FontSize" Value="13.5"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="PasswordBox">
            <Border x:Name="bd" Background="{StaticResource FieldBg}" BorderBrush="{StaticResource FieldBorder}" BorderThickness="1" CornerRadius="8" Padding="10,7">
              <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Btn" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="#262B37" BorderBrush="#383F4F" BorderThickness="1" CornerRadius="8" Padding="12,6">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#303647"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="b" Property="Background" Value="#20242F"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="FillRepeat" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton">
            <Border Height="4" CornerRadius="2" Background="{StaticResource Accent}"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="EmptyRepeat" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton">
            <Border Background="Transparent"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Slim" TargetType="Slider">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Slider">
            <Grid Height="24" Background="Transparent">
              <Border Height="4" CornerRadius="2" Background="#2E3442" VerticalAlignment="Center"/>
              <Track x:Name="PART_Track">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource FillRepeat}"/>
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource EmptyRepeat}"/>
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                  <Thumb>
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Ellipse Width="16" Height="16" Fill="White" Stroke="{StaticResource Accent}" StrokeThickness="3"/>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="10"/>
      <Setter Property="MinWidth" Value="10"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="Transparent">
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.Thumb>
                  <Thumb>
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Border Background="#40FFFFFF" CornerRadius="3" Margin="3,2"/>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Grid.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
  <Grid Margin="20,10,20,14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Header -->
    <Grid Margin="0,0,0,12">
      <StackPanel Orientation="Horizontal">
        <Image x:Name="Logo" Width="40" Height="40" RenderOptions.BitmapScalingMode="HighQuality"/>
        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="Cruce" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource Text}" FontFamily="Segoe UI Variable Display, Segoe UI"/>
          <TextBlock Text="Un mouse y un teclado para tus dos PCs" Foreground="{StaticResource Muted}" FontSize="12.5"/>
        </StackPanel>
      </StackPanel>
      <Border x:Name="Pill" HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="15" Padding="12,7" Background="#26FFB547" BorderThickness="1" BorderBrush="#40FFB547">
        <StackPanel Orientation="Horizontal">
          <Ellipse x:Name="PillDot" Width="8" Height="8" Fill="#FFB547" VerticalAlignment="Center"/>
          <TextBlock x:Name="PillText" Margin="8,0,0,0" Text="Buscando la otra PC…" Foreground="{StaticResource Text}" FontSize="12.5"/>
        </StackPanel>
      </Border>
    </Grid>

    <!-- Layout map -->
    <Border Grid.Row="1" Style="{StaticResource Card}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="176"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel>
          <TextBlock Text="DISPOSICIÓN" Style="{StaticResource Section}" VerticalAlignment="Center"/>
          <TextBlock x:Name="ModeText" HorizontalAlignment="Right" Foreground="{StaticResource Muted}" FontSize="12.5" Text="Estás usando esta PC"/>
        </DockPanel>
        <Canvas x:Name="Map" Grid.Row="1" ClipToBounds="False" Margin="0,8,0,8" Background="Transparent"/>
        <DockPanel Grid.Row="2" LastChildFill="False">
          <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
            <TextBlock Text="¿Dónde está la otra PC?" Foreground="{StaticResource Text}" FontSize="13"/>
            <TextBlock x:Name="SideHint" Text="Se sincroniza sola en las dos PCs." Foreground="{StaticResource Faint}" FontSize="11.5" Margin="0,2,0,0"/>
          </StackPanel>
          <Border DockPanel.Dock="Right" Background="#E6141720" BorderBrush="#26FFFFFF" BorderThickness="1" CornerRadius="10" Padding="2">
            <StackPanel Orientation="Horizontal">
              <RadioButton x:Name="SideLeft" GroupName="side" Style="{StaticResource Seg}" Content="←  Izquierda"/>
              <RadioButton x:Name="SideRight" GroupName="side" Style="{StaticResource Seg}" Content="Derecha  →"/>
              <RadioButton x:Name="SideTop" GroupName="side" Style="{StaticResource Seg}" Content="↑  Arriba"/>
              <RadioButton x:Name="SideBottom" GroupName="side" Style="{StaticResource Seg}" Content="↓  Abajo"/>
            </StackPanel>
          </Border>
        </DockPanel>
      </Grid>
    </Border>

    <!-- Stats + live latency graph -->
    <Grid Grid.Row="2" Margin="0,12,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="12"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="12"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="12"/>
        <ColumnDefinition Width="2.3*"/>
      </Grid.ColumnDefinitions>
      <Border Style="{StaticResource Card}" Padding="16,12">
        <StackPanel>
          <TextBlock Text="LATENCIA" Style="{StaticResource Section}"/>
          <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
            <TextBlock x:Name="StatRtt" Text="–" Style="{StaticResource StatValue}"/>
            <TextBlock Text=" ms" Foreground="{StaticResource Muted}" FontSize="13" VerticalAlignment="Bottom" Margin="0,0,0,5"/>
          </StackPanel>
          <TextBlock x:Name="StatRttSub" Text="ida y vuelta" Foreground="{StaticResource Faint}" FontSize="11.5"/>
        </StackPanel>
      </Border>
      <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16,12">
        <StackPanel>
          <TextBlock Text="PICOS (P95)" Style="{StaticResource Section}"/>
          <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
            <TextBlock x:Name="StatP95" Text="–" Style="{StaticResource StatValue}"/>
            <TextBlock Text=" ms" Foreground="{StaticResource Muted}" FontSize="13" VerticalAlignment="Bottom" Margin="0,0,0,5"/>
          </StackPanel>
          <TextBlock x:Name="StatMax" Text="máximo –" Foreground="{StaticResource Faint}" FontSize="11.5"/>
        </StackPanel>
      </Border>
      <Border Grid.Column="4" Style="{StaticResource Card}" Padding="16,12">
        <StackPanel>
          <TextBlock Text="PÉRDIDA" Style="{StaticResource Section}"/>
          <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
            <TextBlock x:Name="StatLoss" Text="–" Style="{StaticResource StatValue}"/>
            <TextBlock Text=" %" Foreground="{StaticResource Muted}" FontSize="13" VerticalAlignment="Bottom" Margin="0,0,0,5"/>
          </StackPanel>
          <TextBlock Text="se recupera sola" Foreground="{StaticResource Faint}" FontSize="11.5"/>
        </StackPanel>
      </Border>
      <Border Grid.Column="6" Style="{StaticResource Card}" Padding="16,12,16,10">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="40"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <DockPanel>
            <TextBlock Text="ÚLTIMOS 60 S" Style="{StaticResource Section}"/>
            <TextBlock x:Name="SparkScale" HorizontalAlignment="Right" Foreground="{StaticResource Faint}" FontSize="11"/>
          </DockPanel>
          <Canvas x:Name="Spark" Grid.Row="1" Margin="0,6,0,4" ClipToBounds="True"/>
          <StackPanel Grid.Row="2" Orientation="Horizontal">
            <TextBlock x:Name="StatPps" Text="–" Foreground="{StaticResource Muted}" FontSize="11.5"/>
            <TextBlock Text=" paquetes/s  ·  " Foreground="{StaticResource Faint}" FontSize="11.5"/>
            <TextBlock x:Name="StatQos" Text="prioridad de voz: –" Foreground="{StaticResource Faint}" FontSize="11.5"/>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

    <!-- Settings -->
    <Border Grid.Row="4" Style="{StaticResource Card}" Margin="0,12,0,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="28"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="AJUSTES" Style="{StaticResource Section}" Margin="0,0,0,12"/>
          <TextBlock Text="Clave compartida" Style="{StaticResource Label}"/>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <PasswordBox x:Name="Secret" Style="{StaticResource PField}"/>
            <TextBox x:Name="SecretPlain" Style="{StaticResource Field}" Visibility="Collapsed"/>
            <Button x:Name="ShowSecret" Grid.Column="1" Style="{StaticResource Btn}" Content="Ver" Margin="8,0,0,0" MinWidth="58"/>
          </Grid>
          <TextBlock x:Name="SecretHint" Text="Poné la misma clave en las dos PCs. Todo viaja cifrado con ella." Style="{StaticResource Hint}"/>
          <TextBlock Text="IP de la otra PC (opcional)" Style="{StaticResource Label}" Margin="0,16,0,6"/>
          <TextBox x:Name="PeerIp" Style="{StaticResource Field}"/>
          <TextBlock Text="Dejalo vacío: se encuentran solas en tu red." Style="{StaticResource Hint}"/>
        </StackPanel>
        <StackPanel Grid.Column="2">
          <DockPanel Margin="0,27,0,0">
            <TextBlock Text="Velocidad del puntero en la otra PC" Style="{StaticResource Label}"/>
            <TextBlock x:Name="SpeedText" HorizontalAlignment="Right" Foreground="{StaticResource Muted}" FontSize="13" Text="1.00×"/>
          </DockPanel>
          <Slider x:Name="Speed" Style="{StaticResource Slim}" Minimum="0.5" Maximum="2" IsMoveToPointEnabled="True" SmallChange="0.05" LargeChange="0.1"/>
          <TextBlock Text="1.00× ya compensa la escala (DPI) de cada pantalla." Style="{StaticResource Hint}"/>
          <CheckBox x:Name="ClipSw" Style="{StaticResource Switch}" Margin="0,16,0,0" Content="Portapapeles compartido (texto e imágenes)"/>
          <CheckBox x:Name="FilesSw" Style="{StaticResource Switch}" Margin="0,12,0,0" Content="Copiar y pegar archivos entre PCs"/>
          <CheckBox x:Name="AutoSw" Style="{StaticResource Switch}" Margin="0,12,0,0" Content="Iniciar con Windows (con permisos de admin)"/>
          <DockPanel Margin="0,12,0,0" LastChildFill="True">
            <Button x:Name="AdminBtn" DockPanel.Dock="Right" Style="{StaticResource Btn}" Content="Reiniciar como admin" Margin="10,0,0,0"/>
            <TextBlock x:Name="AdminText" Style="{StaticResource Hint}" Margin="0" VerticalAlignment="Center"/>
          </DockPanel>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Footer -->
    <DockPanel Grid.Row="5" Margin="4,12,4,0">
      <Border DockPanel.Dock="Left" Background="#1AFFFFFF" CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
        <TextBlock Text="Ctrl + Alt + F12" Foreground="{StaticResource Text}" FontSize="11.5" FontFamily="Cascadia Mono, Consolas"/>
      </Border>
      <TextBlock DockPanel.Dock="Left" Text="cambia de PC" Foreground="{StaticResource Muted}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"/>
      <Button x:Name="ReportBtn" DockPanel.Dock="Right" Style="{StaticResource Btn}" Content="Reporte" Margin="8,0,0,0"/>
      <Button x:Name="LogBtn" DockPanel.Dock="Right" Style="{StaticResource Btn}" Content="Abrir registro" Margin="8,0,0,0"/>
      <Button x:Name="UpdBtn" DockPanel.Dock="Right" Style="{StaticResource Btn}" Content="Buscar actualizaciones" Margin="12,0,0,0"/>
      <TextBlock x:Name="Footer" HorizontalAlignment="Right" Foreground="{StaticResource Faint}" FontSize="11.5" VerticalAlignment="Center"/>
    </DockPanel>
  </Grid>
</ScrollViewer>
</Grid>